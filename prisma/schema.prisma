generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model Brand {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @unique
  slug       String    @unique
  icon       String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  products   Product[]

  @@map("brands")
  @@schema("public")
}

model CartItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  quantity   Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile    Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, product_id])
  @@index([user_id])
  @@map("cart_items")
  @@schema("public")
}

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  image       String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  banners     Banner[]
  products    Product[]
  sections    HomepageSection[]

  @@map("categories")
  @@schema("public")
}

model Banner {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  kicker      String?
  body        String
  cta_label   String?
  cta_href    String?
  image       String?
  mobile_image String?
  placement   BannerPlacement @default(main)
  category_id String?        @db.Uuid
  sort_order  Int            @default(0)
  is_enabled  Boolean        @default(true)
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  category    Category?      @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([placement, is_enabled, sort_order])
  @@index([category_id, placement, is_enabled, sort_order])
  @@map("banners")
  @@schema("public")
}

model HomepageSection {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  section_type HomepageSectionType @default(category_products)
  category_id String?             @db.Uuid
  sort_order  Int                 @default(0)
  product_limit Int               @default(8)
  is_enabled  Boolean             @default(true)
  created_at  DateTime            @default(now()) @db.Timestamptz(6)
  updated_at  DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  category    Category?           @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([section_type, is_enabled, sort_order])
  @@index([category_id])
  @@map("homepage_sections")
  @@schema("public")
}

model OrderItem {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String   @db.Uuid
  product_id            String?  @db.Uuid
  quantity              Int
  price_at_purchase_kes Int
  order                 Order    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product               Product? @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([order_id])
  @@map("order_items")
  @@schema("public")
}

model Order {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?        @db.Uuid
  status         OrderStatus    @default(pending)
  payment_method PaymentMethod?
  total_kes      Int            @default(0)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  order_items    OrderItem[]
  profile        Profile?       @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id])
  @@map("orders")
  @@schema("public")
}

model Product {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String           @unique
  description    String
  category_id    String?          @db.Uuid
  brand_id       String?          @db.Uuid
  price_kes      Int
  condition      ProductCondition @default(new)
  stock_status   StockStatus      @default(in_stock)
  stock_quantity Int              @default(0)
  images         Json             @default("[]") @db.JsonB
  specs          Json             @default("{}") @db.JsonB
  is_featured    Boolean          @default(false)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  cart_items     CartItem[]
  order_items    OrderItem[]
  brand          Brand?           @relation(fields: [brand_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  category       Category?        @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([brand_id])
  @@index([category_id])
  @@index([is_featured], map: "products_featured_idx")
  @@map("products")
  @@schema("public")
}

model Profile {
  id         String      @id @db.Uuid
  full_name  String?
  phone      String?
  role       ProfileRole @default(customer)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  cart_items CartItem[]
  orders     Order[]

  @@map("profiles")
  @@schema("public")
}

model QuoteRequest {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  email          String
  phone          String
  service_needed String
  message        String
  status         QuoteStatus @default(new)
  created_at     DateTime    @default(now()) @db.Timestamptz(6)

  @@map("quote_requests")
  @@schema("public")
}

model ServiceEntry {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  slug                String   @unique
  description         String
  image               String?
  price_kes           Int?
  show_request_quote  Boolean  @default(true)
  sort_order          Int      @default(0)
  is_enabled          Boolean  @default(true)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([is_enabled, sort_order])
  @@map("service_entries")
  @@schema("public")
}

enum BannerPlacement {
  main
  category
  services
  top
  middle
  bottom

  @@map("banner_placement")
  @@schema("public")
}

enum HomepageSectionType {
  category_products
  latest_products
  services
  brands

  @@map("homepage_section_type")
  @@schema("public")
}

enum OrderStatus {
  pending
  processing
  paid
  fulfilled
  cancelled

  @@map("order_status")
  @@schema("public")
}

enum PaymentMethod {
  mpesa
  card

  @@map("payment_method")
  @@schema("public")
}

enum ProductCondition {
  new
  refurbished

  @@map("product_condition")
  @@schema("public")
}

enum ProfileRole {
  customer
  admin

  @@map("profile_role")
  @@schema("public")
}

enum QuoteStatus {
  new
  contacted
  closed

  @@map("quote_status")
  @@schema("public")
}

enum StockStatus {
  in_stock
  backorder
  out_of_stock

  @@map("stock_status")
  @@schema("public")
}
