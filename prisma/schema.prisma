generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model Brand {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @unique
  slug       String    @unique
  icon       String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  products   Product[]

  @@map("brands")
  @@schema("public")
}

model CartItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  quantity   Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile    Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, product_id])
  @@index([user_id])
  @@map("cart_items")
  @@schema("public")
}

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  icon        String?
  image       String?
  parent_id   String?   @db.Uuid
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  banners     Banner[]
  icecat_mappings IcecatCategoryMapping[]
  parent      Category? @relation("CategoryChildren", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children    Category[] @relation("CategoryChildren")
  products    Product[]
  sections    HomepageSection[]

  @@index([parent_id, sort_order])
  @@map("categories")
  @@schema("public")
}

model Banner {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  kicker      String?
  body        String
  cta_label   String?
  cta_href    String?
  image       String?
  mobile_image String?
  placement   BannerPlacement @default(main)
  category_id String?        @db.Uuid
  sort_order  Int            @default(0)
  is_enabled  Boolean        @default(true)
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  category    Category?      @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([placement, is_enabled, sort_order])
  @@index([category_id, placement, is_enabled, sort_order])
  @@map("banners")
  @@schema("public")
}

model HomepageSection {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  section_type HomepageSectionType @default(category_products)
  category_id String?             @db.Uuid
  sort_order  Int                 @default(0)
  product_limit Int               @default(8)
  is_enabled  Boolean             @default(true)
  created_at  DateTime            @default(now()) @db.Timestamptz(6)
  updated_at  DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  category    Category?           @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([section_type, is_enabled, sort_order])
  @@index([category_id])
  @@map("homepage_sections")
  @@schema("public")
}

model OrderItem {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String   @db.Uuid
  product_id            String?  @db.Uuid
  quantity              Int
  price_at_purchase_kes Int
  service_label         String?
  serials               ProductSerial[]
  order                 Order    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product               Product? @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([order_id])
  @@map("order_items")
  @@schema("public")
}

model Order {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?        @db.Uuid
  status         OrderStatus    @default(pending)
  payment_method PaymentMethod?
  total_kes      Int            @default(0)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  order_items    OrderItem[]
  payments        PaymentTransaction[]
  profile        Profile?       @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  serials        ProductSerial[]

  @@index([user_id])
  @@index([created_at])
  @@map("orders")
  @@schema("public")
}

model Product {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String           @unique
  description    String
  mpn            String?
  sku            String?
  category_id    String?          @db.Uuid
  brand_id       String?          @db.Uuid
  price_kes      Int
  cost_price_kes Int?
  supplier_name  String?
  supplier_lead_time_days Int?
  reorder_level  Int              @default(0)
  reorder_quantity Int            @default(0)
  is_published   Boolean          @default(true)
  enriched_fields Json            @default("{}") @db.JsonB
  enriched_at    DateTime?        @db.Timestamptz(6)
  condition      ProductCondition @default(new)
  stock_status   StockStatus      @default(in_stock)
  stock_quantity Int              @default(0)
  images         Json             @default("[]") @db.JsonB
  specs          Json             @default("{}") @db.JsonB
  is_featured    Boolean          @default(false)
  archived_at    DateTime?        @db.Timestamptz(6)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  cart_items     CartItem[]
  order_items    OrderItem[]
  quote_lines    QuoteLine[]
  stock_movements StockMovement[]
  price_history  PriceHistory[]
  serials        ProductSerial[]
  enrichment_jobs EnrichmentJob[]
  printer_compatibilities ProductCompatibility[] @relation("PrinterCompatibility")
  consumable_compatibilities ProductCompatibility[] @relation("ConsumableCompatibility")
  brand          Brand?           @relation(fields: [brand_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  category       Category?        @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([brand_id])
  @@index([category_id])
  @@index([mpn])
  @@index([sku])
  @@index([supplier_name])
  @@index([is_published])
  @@index([archived_at])
  @@index([is_published, is_featured, created_at])
  @@index([updated_at])
  @@index([is_featured], map: "products_featured_idx")
  @@map("products")
  @@schema("public")
}

model PaymentTransaction {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String         @db.Uuid
  provider              PaymentProvider
  method                PaymentMethod
  status                PaymentStatus   @default(pending)
  amount_kes            Int
  merchant_reference    String         @unique
  provider_reference    String?
  checkout_request_id   String?        @unique
  phone                 String?
  redirect_url          String?
  failure_reason        String?
  raw_request           Json?          @db.JsonB
  raw_response          Json?          @db.JsonB
  verified_at           DateTime?      @db.Timestamptz(6)
  created_at            DateTime       @default(now()) @db.Timestamptz(6)
  updated_at            DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  order                 Order          @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id, status])
  @@index([provider, status])
  @@map("payment_transactions")
  @@schema("public")
}

model Profile {
  id         String      @id @db.Uuid
  full_name  String?
  phone      String?
  role       ProfileRole @default(customer)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  cart_items CartItem[]
  orders     Order[]
  stock_movements StockMovement[]
  changed_prices  PriceHistory[] @relation("PriceChangedBy")
  audit_logs      AuditLog[]
  enrichment_jobs EnrichmentJob[]

  @@map("profiles")
  @@schema("public")
}

model QuoteRequest {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  email          String
  phone          String
  service_needed String
  message        String
  status         QuoteStatus @default(new)
  owner_id       String?     @db.Uuid
  quoted_value_kes Int?
  follow_up_at   DateTime?   @db.Timestamptz(6)
  issued_at      DateTime?   @db.Timestamptz(6)
  valid_until    DateTime?   @db.Timestamptz(6)
  payment_terms  String?
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  lines          QuoteLine[]

  @@index([created_at])
  @@map("quote_requests")
  @@schema("public")
}

model QuoteLine {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote_id    String       @db.Uuid
  product_id  String?      @db.Uuid
  description String
  quantity    Int
  unit_price_kes Int
  unit_cost_kes  Int?
  sort_order  Int          @default(0)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  quote       QuoteRequest @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product     Product?     @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([quote_id])
  @@index([product_id])
  @@map("quote_lines")
  @@schema("public")
}

model ProductCompatibility {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  printer_id   String                    @db.Uuid
  consumable_id String                   @db.Uuid
  relation_type ProductCompatibilityType
  created_at   DateTime                  @default(now()) @db.Timestamptz(6)
  printer      Product                   @relation("PrinterCompatibility", fields: [printer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  consumable   Product                   @relation("ConsumableCompatibility", fields: [consumable_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([printer_id, consumable_id, relation_type])
  @@index([printer_id])
  @@index([consumable_id])
  @@map("product_compatibilities")
  @@schema("public")
}

model StockMovement {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String              @db.Uuid
  delta      Int
  reason     StockMovementReason
  reference  String?
  user_id    String?             @db.Uuid
  created_at DateTime            @default(now()) @db.Timestamptz(6)
  product    Product             @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       Profile?            @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([product_id, created_at])
  @@index([user_id])
  @@map("stock_movements")
  @@schema("public")
}

model PriceHistory {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id     String    @db.Uuid
  price_kes      Int
  effective_from DateTime  @default(now()) @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)
  changed_by     String?   @db.Uuid
  note           String?
  product        Product   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           Profile?  @relation("PriceChangedBy", fields: [changed_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([product_id, effective_from])
  @@index([changed_by])
  @@map("price_history")
  @@schema("public")
}

model ProductSerial {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id      String              @db.Uuid
  serial_number   String
  status          ProductSerialStatus @default(IN_STOCK)
  order_id        String?             @db.Uuid
  order_item_id   String?             @db.Uuid
  delivered_at    DateTime?           @db.Timestamptz(6)
  warranty_months Int?
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  product         Product             @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order           Order?              @relation(fields: [order_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  order_item      OrderItem?          @relation(fields: [order_item_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([product_id, serial_number])
  @@index([status])
  @@index([order_id])
  @@map("product_serials")
  @@schema("public")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?  @db.Uuid
  entity     String
  entity_id  String
  action     String
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       Profile? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([entity, entity_id])
  @@index([user_id, created_at])
  @@map("audit_logs")
  @@schema("public")
}

model EnrichmentJob {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id  String              @db.Uuid
  provider    String
  status      EnrichmentJobStatus @default(PENDING)
  requested_by String?            @db.Uuid
  started_at  DateTime?           @db.Timestamptz(6)
  finished_at DateTime?           @db.Timestamptz(6)
  error       String?
  payload     Json?               @db.JsonB
  created_at  DateTime            @default(now()) @db.Timestamptz(6)
  product     Product             @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requester   Profile?            @relation(fields: [requested_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([product_id, status])
  @@index([status, created_at])
  @@map("enrichment_jobs")
  @@schema("public")
}

model IcecatLookupCache {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  lookup_key  String
  result      Json     @db.JsonB
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([provider, lookup_key])
  @@index([updated_at])
  @@map("icecat_lookup_cache")
  @@schema("public")
}

model IcecatCategoryMapping {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  icecat_category  String   @unique
  category_id      String   @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  category         Category @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([category_id])
  @@map("icecat_category_mappings")
  @@schema("public")
}

model ServiceEntry {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  slug                String   @unique
  description         String
  image               String?
  price_kes           Int?
  show_request_quote  Boolean  @default(true)
  sort_order          Int      @default(0)
  is_enabled          Boolean  @default(true)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([is_enabled, sort_order])
  @@map("service_entries")
  @@schema("public")
}

enum BannerPlacement {
  main
  category
  services
  top
  middle
  bottom

  @@map("banner_placement")
  @@schema("public")
}

enum HomepageSectionType {
  category_products
  latest_products
  services
  brands

  @@map("homepage_section_type")
  @@schema("public")
}

enum OrderStatus {
  pending
  processing
  paid
  fulfilled
  cancelled

  @@map("order_status")
  @@schema("public")
}

enum PaymentMethod {
  mpesa
  card

  @@map("payment_method")
  @@schema("public")
}

enum PaymentProvider {
  safaricom_daraja
  pesapal

  @@map("payment_provider")
  @@schema("public")
}

enum PaymentStatus {
  pending
  initiated
  processing
  paid
  failed
  cancelled

  @@map("payment_status")
  @@schema("public")
}

enum ProductCondition {
  new
  refurbished

  @@map("product_condition")
  @@schema("public")
}

enum ProfileRole {
  customer
  admin
  owner
  manager
  sales
  store

  @@map("profile_role")
  @@schema("public")
}

enum QuoteStatus {
  new
  contacted
  closed

  @@map("quote_status")
  @@schema("public")
}

enum StockStatus {
  in_stock
  backorder
  out_of_stock

  @@map("stock_status")
  @@schema("public")
}

enum ProductCompatibilityType {
  TONER
  DRUM
  INKJET
  SPARE_PART
  ACCESSORY

  @@map("product_compatibility_type")
  @@schema("public")
}

enum StockMovementReason {
  SALE
  PURCHASE
  RETURN
  DAMAGE
  CORRECTION
  OPENING_BALANCE

  @@map("stock_movement_reason")
  @@schema("public")
}

enum ProductSerialStatus {
  IN_STOCK
  ALLOCATED
  DELIVERED
  RETURNED

  @@map("product_serial_status")
  @@schema("public")
}

enum EnrichmentJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED

  @@map("enrichment_job_status")
  @@schema("public")
}
