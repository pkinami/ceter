generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model Brand {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @unique
  slug       String    @unique
  icon       String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  products   Product[]

  @@map("brands")
  @@schema("public")
}

model CartItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  quantity   Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile    Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, product_id])
  @@index([user_id])
  @@map("cart_items")
  @@schema("public")
}

model Category {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String            @unique
  description String?
  icon        String?
  image       String?
  parent_id   String?           @db.Uuid
  sort_order  Int               @default(0)
  created_at  DateTime          @default(now()) @db.Timestamptz(6)
  banners     Banner[]
  parent      Category?         @relation("CategoryChildren", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children    Category[]        @relation("CategoryChildren")
  products    Product[]
  sections    HomepageSection[]

  @@index([parent_id, sort_order])
  @@map("categories")
  @@schema("public")
}

model Banner {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  banner_key     String?         @unique
  internal_name  String?
  title          String
  kicker         String?
  body           String
  cta_label      String?
  cta_href       String?
  destination_type String        @default("internal")
  image          String?
  laptop_image   String?
  mobile_image   String?
  image_path     String?
  laptop_image_path String?
  mobile_image_path String?
  image_variants Json            @default("[]") @db.JsonB
  alt_text       String?
  mobile_focal_position String   @default("center center")
  landscape_focal_position String @default("center center")
  ultrawide_focal_position String @default("center center")
  text_position  String          @default("left")
  overlay_opacity Int            @default(70)
  badge_enabled  Boolean         @default(false)
  badge_text     String?
  badge_color    String?
  badge_position String          @default("top-left")
  placement      BannerPlacement @default(main)
  category_id    String?         @db.Uuid
  sort_order     Int             @default(0)
  starts_at      DateTime?       @db.Timestamptz(6)
  ends_at        DateTime?       @db.Timestamptz(6)
  is_enabled     Boolean         @default(true)
  archived_at    DateTime?       @db.Timestamptz(6)
  created_by_id  String?         @db.Uuid
  updated_by_id  String?         @db.Uuid
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  category       Category?       @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([placement, is_enabled, sort_order])
  @@index([category_id, placement, is_enabled, sort_order])
  @@index([archived_at, starts_at, ends_at])
  @@map("banners")
  @@schema("public")
}

model HomepageSection {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  section_type  HomepageSectionType @default(category_products)
  category_id   String?             @db.Uuid
  sort_order    Int                 @default(0)
  product_limit Int                 @default(8)
  is_enabled    Boolean             @default(true)
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at    DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  category      Category?           @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([section_type, is_enabled, sort_order])
  @@index([category_id])
  @@map("homepage_sections")
  @@schema("public")
}

model OrderItem {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String          @db.Uuid
  product_id            String?         @db.Uuid
  quantity              Int
  price_at_purchase_kes Int
  service_label         String?
  reserved_quantity     Decimal         @default(0) @db.Decimal(18, 3)
  fulfilled_quantity    Decimal         @default(0) @db.Decimal(18, 3)
  backordered_quantity  Decimal         @default(0) @db.Decimal(18, 3)
  reservation_key       String?
  serials               ProductSerial[]
  backorders            SalesBackorder[]
  delivery_lines        DeliveryLine[]
  order                 Order           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product               Product?        @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([order_id])
  @@map("order_items")
  @@schema("public")
}

model Order {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number          String               @unique
  source                String               @default("storefront")
  payment_status        String               @default("pending")
  fulfilment_status     String               @default("pending")
  delivery_status       String               @default("pending")
  fiscalization_status  String               @default("not_ready")
  salesperson_id        String?              @db.Uuid
  inventory_location_id String?              @db.Uuid
  confirmed_at          DateTime?            @db.Timestamptz(6)
  cancelled_at          DateTime?            @db.Timestamptz(6)
  reservation_key       String?
  user_id               String?              @db.Uuid
  status                OrderStatus          @default(pending)
  payment_method        PaymentMethod?
  fulfillment_method    FulfillmentMethod    @default(delivery)
  delivery_region       DeliveryRegion?
  delivery_fee_kes      Int                  @default(0)
  delivery_name         String?
  delivery_phone        String?
  delivery_email        String?
  delivery_location     String?
  delivery_instructions String?
  total_kes             Int                  @default(0)
  customer_id           String?              @db.Uuid
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  order_items           OrderItem[]
  payments              PaymentTransaction[]
  deliveries            Delivery[]
  sales_backorders      SalesBackorder[]
  service_installations ServiceInstallation[]
  customer              Customer?            @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  profile               Profile?             @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  serials               ProductSerial[]

  @@index([user_id])
  @@index([customer_id])
  @@index([created_at])
  @@index([source])
  @@index([payment_status])
  @@index([fulfilment_status])
  @@index([delivery_status])
  @@index([fiscalization_status])
  @@map("orders")
  @@schema("public")
}

model Product {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  slug                       String                 @unique
  description                String
  mpn                        String?
  sku                        String?
  category_id                String?                @db.Uuid
  brand_id                   String?                @db.Uuid
  price_kes                  Int
  cost_price_kes             Int?
  supplier_name              String?
  supplier_lead_time_days    Int?
  reorder_level              Int                    @default(0)
  reorder_quantity           Int                    @default(0)
  is_published               Boolean                @default(true)
  condition                  ProductCondition       @default(new)
  stock_status               StockStatus            @default(in_stock)
  stock_quantity             Int                    @default(0)
  images                     Json                   @default("[]") @db.JsonB
  specs                      Json                   @default("{}") @db.JsonB
  is_featured                Boolean                @default(false)
  show_offer_badge           Boolean                @default(false)
  show_flash_sale_badge      Boolean                @default(false)
  etims_item_code             String?
  etims_classification_code   String?
  etims_unit_code             String?
  etims_packaging_unit_code   String?
  tax_type_code               String?
  tax_rate                    Decimal?               @db.Decimal(5, 2)
  tax_mapping_status          TaxMappingStatus       @default(missing)
  tax_mapping_review_note     String?
  archived_at                DateTime?              @db.Timestamptz(6)
  created_at                 DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  cart_items                 CartItem[]
  order_items                OrderItem[]
  quote_items                QuoteItem[]
  proforma_invoice_items     ProformaInvoiceItem[]
  invoice_items              InvoiceItem[]
  purchase_order_items       PurchaseOrderItem[]
  goods_received_items       GoodsReceivedNoteItem[]
  supplier_invoice_items     SupplierInvoiceItem[]
  tender_products            TenderProduct[]
  quote_lines                QuoteLine[]
  stock_movements            StockMovement[]
  inventory_balances         InventoryBalance[]
  inventory_movements        InventoryMovement[]
  stock_adjustments          StockAdjustment[]
  stock_transfer_lines       StockTransferLine[]
  stock_take_lines           StockTakeLine[]
  serial_numbers             SerialNumber[]
  purchase_order_lines       PurchaseOrderLine[]
  goods_receipt_lines        GoodsReceiptLine[]
  purchase_return_lines      PurchaseReturnLine[]
  delivery_lines             DeliveryLine[]
  sales_backorders           SalesBackorder[]
  customer_equipment         CustomerEquipment[]
  service_parts              ServicePartUsage[]
  equipment_warranties       EquipmentWarranty[]
  mps_agreements             MpsAgreement[]
  loan_units                 ServiceLoanUnit[]
  stock_transfer_items       StockTransferItem[]
  stock_take_items           StockTakeItem[]
  price_history              PriceHistory[]
  serials                    ProductSerial[]
  printer_compatibilities    ProductCompatibility[] @relation("PrinterCompatibility")
  consumable_compatibilities ProductCompatibility[] @relation("ConsumableCompatibility")
  brand                      Brand?                 @relation(fields: [brand_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  category                   Category?              @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([brand_id])
  @@index([category_id])
  @@index([mpn])
  @@index([sku])
  @@index([tax_mapping_status])
  @@index([supplier_name])
  @@index([is_published])
  @@index([archived_at])
  @@index([is_published, is_featured, created_at])
  @@index([updated_at])
  @@index([is_featured], map: "products_featured_idx")
  @@index([show_offer_badge])
  @@index([show_flash_sale_badge])
  @@map("products")
  @@schema("public")
}

model PaymentTransaction {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id            String          @db.Uuid
  provider            PaymentProvider
  method              PaymentMethod
  status              PaymentStatus   @default(pending)
  amount_kes          Int
  merchant_reference  String          @unique
  provider_reference  String?
  checkout_request_id String?         @unique
  phone               String?
  redirect_url        String?
  failure_reason      String?
  raw_request         Json?           @db.JsonB
  raw_response        Json?           @db.JsonB
  verified_at         DateTime?       @db.Timestamptz(6)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  order               Order           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id, status])
  @@index([provider, status])
  @@map("payment_transactions")
  @@schema("public")
}

model Profile {
  id                    String          @id @db.Uuid
  full_name             String?
  phone                 String?
  email                 String?
  delivery_region       DeliveryRegion?
  delivery_location     String?
  delivery_instructions String?
  role                  ProfileRole     @default(customer)
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  cart_items            CartItem[]
  orders                Order[]
  customers             Customer[]
  stock_movements       StockMovement[]
  inventory_movements   InventoryMovement[]
  stock_adjustments     StockAdjustment[]
  stock_transfers       StockTransfer[]
  stock_takes           StockTake[]
  changed_prices        PriceHistory[]  @relation("PriceChangedBy")
  audit_logs            AuditLog[]
  notifications         NotificationHistory[]
  sales_commissions     SalesCommission[]
  sales_commission_payments SalesCommissionPayment[]
  import_logs           ImportLog[]
  assigned_service_tickets ServiceTicket[] @relation("ServiceTicketAssignee")
  service_ticket_assignments ServiceTicketAssignment[] @relation("ServiceTicketAssignmentTechnician")
  technician_work_logs  TechnicianWorkLog[] @relation("TechnicianWorkLogs")
  assigned_installations ServiceInstallation[] @relation("ServiceInstallationAssignee")
  maintenance_occurrences MaintenanceOccurrence[] @relation("MaintenanceOccurrenceTechnician")
  captured_meter_readings MeterReading[] @relation("MeterReadingCapturedBy")
  internal_notifications InternalNotification[] @relation("InternalNotificationRecipient")

  @@map("profiles")
  @@schema("public")
}

model QuoteRequest {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  email            String
  phone            String
  service_needed   String
  message          String
  status           QuoteStatus @default(new)
  owner_id         String?     @db.Uuid
  assigned_to_id   String?     @db.Uuid
  related_quote_id String?     @db.Uuid
  internal_status  String      @default("new")
  source           String      @default("storefront")
  internal_notes   String?
  status_history   Json        @default("[]") @db.JsonB
  converted_at     DateTime?   @db.Timestamptz(6)
  converted_by_id  String?     @db.Uuid
  quoted_value_kes Int?
  follow_up_at     DateTime?   @db.Timestamptz(6)
  issued_at        DateTime?   @db.Timestamptz(6)
  valid_until      DateTime?   @db.Timestamptz(6)
  payment_terms    String?
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  lines            QuoteLine[]

  @@index([created_at])
  @@index([internal_status])
  @@index([related_quote_id])
  @@map("quote_requests")
  @@schema("public")
}

model DeliveryFee {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  region     DeliveryRegion @unique
  fee_kes    Int            @default(0)
  is_enabled Boolean        @default(true)
  updated_at DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("delivery_fees")
  @@schema("public")
}

model QuoteLine {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote_id       String       @db.Uuid
  product_id     String?      @db.Uuid
  description    String
  quantity       Int
  unit_price_kes Int
  unit_cost_kes  Int?
  sort_order     Int          @default(0)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  quote          QuoteRequest @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product        Product?     @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([quote_id])
  @@index([product_id])
  @@map("quote_lines")
  @@schema("public")
}

model ProductCompatibility {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  printer_id    String                   @db.Uuid
  consumable_id String                   @db.Uuid
  relation_type ProductCompatibilityType
  created_at    DateTime                 @default(now()) @db.Timestamptz(6)
  printer       Product                  @relation("PrinterCompatibility", fields: [printer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  consumable    Product                  @relation("ConsumableCompatibility", fields: [consumable_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([printer_id, consumable_id, relation_type])
  @@index([printer_id])
  @@index([consumable_id])
  @@map("product_compatibilities")
  @@schema("public")
}

model StockMovement {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String              @db.Uuid
  delta      Int
  reason     StockMovementReason
  reference  String?
  unit_cost_kes Int?
  supplier_id String?            @db.Uuid
  purchase_order_id String?      @db.Uuid
  goods_received_note_id String? @db.Uuid
  user_id    String?             @db.Uuid
  created_at DateTime            @default(now()) @db.Timestamptz(6)
  product    Product             @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  supplier   Supplier?           @relation(fields: [supplier_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  purchase_order PurchaseOrder?   @relation(fields: [purchase_order_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  goods_received_note GoodsReceivedNote? @relation(fields: [goods_received_note_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user       Profile?            @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([product_id, created_at])
  @@index([supplier_id])
  @@index([purchase_order_id])
  @@index([goods_received_note_id])
  @@index([user_id])
  @@map("stock_movements")
  @@schema("public")
}

model InventoryLocation {
  id                           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                         String
  code                         String                 @unique
  branch                       String?
  location_type                InventoryLocationType  @default(main_warehouse)
  description                  String?
  address                      String?
  is_active                    Boolean                @default(true)
  is_default_receiving         Boolean                @default(false)
  is_default_dispatch          Boolean                @default(false)
  archived_at                  DateTime?              @db.Timestamptz(6)
  created_by_id                String?                @db.Uuid
  created_at                   DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  balances                     InventoryBalance[]
  movements                    InventoryMovement[]
  adjustments                  StockAdjustment[]
  source_transfers             StockTransfer[]        @relation("StockTransferSourceLocation")
  destination_transfers        StockTransfer[]        @relation("StockTransferDestinationLocation")
  stock_takes                  StockTake[]
  serial_numbers               SerialNumber[]
  goods_receipts               GoodsReceipt[]
  purchase_returns             PurchaseReturn[]
  service_parts                ServicePartUsage[]
  loan_units                   ServiceLoanUnit[]

  @@index([branch])
  @@index([is_active])
  @@map("inventory_locations")
  @@schema("public")
}

model InventoryBalance {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id        String            @db.Uuid
  location_id       String            @db.Uuid
  on_hand_quantity  Decimal           @default(0) @db.Decimal(18, 3)
  reserved_quantity Decimal           @default(0) @db.Decimal(18, 3)
  available_quantity Decimal          @default(0) @db.Decimal(18, 3)
  incoming_quantity Decimal           @default(0) @db.Decimal(18, 3)
  updated_at        DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  product           Product           @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location          InventoryLocation @relation(fields: [location_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([product_id, location_id])
  @@index([location_id])
  @@index([available_quantity])
  @@map("inventory_balances")
  @@schema("public")
}

model InventoryMovement {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id            String                @db.Uuid
  location_id           String                @db.Uuid
  quantity              Decimal               @db.Decimal(18, 3)
  unit_of_measure       String                @default("unit")
  movement_type         InventoryMovementType
  source_document_type  String
  source_document_id    String
  source_line_id        String?
  reference             String
  reason                String
  user_id               String?               @db.Uuid
  branch                String?
  correlation_id        String
  unit_cost_kes         Int?
  running_balance       Decimal?              @db.Decimal(18, 3)
  status                InventoryMovementStatus @default(posted)
  reversed_movement_id  String?               @db.Uuid
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  product               Product               @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location              InventoryLocation     @relation(fields: [location_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user                  Profile?              @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([source_document_type, source_document_id, source_line_id, movement_type, location_id, product_id], map: "inventory_movements_source_unique")
  @@index([product_id, created_at])
  @@index([location_id, created_at])
  @@index([movement_type])
  @@index([correlation_id])
  @@map("inventory_movements")
  @@schema("public")
}

model StockAdjustment {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adjustment_number String          @unique
  product_id        String          @db.Uuid
  location_id       String          @db.Uuid
  quantity          Decimal         @db.Decimal(18, 3)
  reason            StockAdjustmentReason
  notes             String?
  status            StockAdjustmentStatus @default(posted)
  correlation_id    String          @unique
  posted_by_id      String?         @db.Uuid
  posted_at         DateTime?       @db.Timestamptz(6)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  product           Product         @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location          InventoryLocation @relation(fields: [location_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  posted_by         Profile?        @relation(fields: [posted_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([product_id, created_at])
  @@index([location_id, created_at])
  @@map("stock_adjustments")
  @@schema("public")
}

model StockTransfer {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transfer_number      String              @unique
  source_location      String
  destination_location String
  source_location_id   String?             @db.Uuid
  destination_location_id String?           @db.Uuid
  status               String              @default("draft")
  transfer_date        DateTime            @db.Date
  notes                String?
  responsible_user_id  String?             @db.Uuid
  created_by_id        String?             @db.Uuid
  submitted_at         DateTime?           @db.Timestamptz(6)
  received_at          DateTime?           @db.Timestamptz(6)
  cancelled_at         DateTime?           @db.Timestamptz(6)
  approved_by_id       String?             @db.Uuid
  dispatched_by_id     String?             @db.Uuid
  received_by_id       String?             @db.Uuid
  dispatched_at        DateTime?           @db.Timestamptz(6)
  correlation_id       String?             @unique
  created_at           DateTime            @default(now()) @db.Timestamptz(6)
  updated_at           DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  responsible_user     Profile?            @relation(fields: [responsible_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  source_inventory_location InventoryLocation? @relation("StockTransferSourceLocation", fields: [source_location_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  destination_inventory_location InventoryLocation? @relation("StockTransferDestinationLocation", fields: [destination_location_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items                StockTransferItem[]
  lines                StockTransferLine[]
  status_history       StockTransferStatusHistory[]

  @@index([status, transfer_date])
  @@index([responsible_user_id])
  @@index([source_location_id])
  @@index([destination_location_id])
  @@map("stock_transfers")
  @@schema("public")
}

model StockTransferItem {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stock_transfer_id   String        @db.Uuid
  product_id          String        @db.Uuid
  quantity            Int
  available_at_submit Int?
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  stock_transfer      StockTransfer @relation(fields: [stock_transfer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
