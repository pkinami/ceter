  @@index([proforma_invoice_id])
  @@index([customer_id])
  @@index([status])
  @@index([due_date])
  @@index([etims_status])
  @@index([invoice_type])
  @@index([payment_status])
  @@index([fiscalization_status])
  @@index([document_status])
  @@index([source_order_id])
  @@map("invoices")
  @@schema("public")
}

model InvoiceItem {
