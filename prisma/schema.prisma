generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model Brand {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @unique
  slug       String    @unique
  icon       String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  products   Product[]

  @@map("brands")
  @@schema("public")
}

model CartItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  quantity   Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile    Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, product_id])
  @@index([user_id])
  @@map("cart_items")
  @@schema("public")
}

model Category {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String            @unique
  description String?
  icon        String?
  image       String?
  parent_id   String?           @db.Uuid
  sort_order  Int               @default(0)
  created_at  DateTime          @default(now()) @db.Timestamptz(6)
  banners     Banner[]
  parent      Category?         @relation("CategoryChildren", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children    Category[]        @relation("CategoryChildren")
  products    Product[]
  sections    HomepageSection[]

  @@index([parent_id, sort_order])
  @@map("categories")
  @@schema("public")
}

model Banner {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  kicker         String?
  body           String
  cta_label      String?
  cta_href       String?
  image          String?
  laptop_image   String?
  mobile_image   String?
  image_variants Json            @default("[]") @db.JsonB
  text_position  String          @default("left")
  overlay_opacity Int            @default(70)
  badge_enabled  Boolean         @default(false)
  badge_text     String?
  badge_color    String?
  badge_position String          @default("top-left")
  placement      BannerPlacement @default(main)
  category_id    String?         @db.Uuid
  sort_order     Int             @default(0)
  is_enabled     Boolean         @default(true)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  category       Category?       @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([placement, is_enabled, sort_order])
  @@index([category_id, placement, is_enabled, sort_order])
  @@map("banners")
  @@schema("public")
}

model HomepageSection {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  section_type  HomepageSectionType @default(category_products)
  category_id   String?             @db.Uuid
  sort_order    Int                 @default(0)
  product_limit Int                 @default(8)
  is_enabled    Boolean             @default(true)
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at    DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  category      Category?           @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([section_type, is_enabled, sort_order])
  @@index([category_id])
  @@map("homepage_sections")
  @@schema("public")
}

model OrderItem {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String          @db.Uuid
  product_id            String?         @db.Uuid
  quantity              Int
  price_at_purchase_kes Int
  service_label         String?
  serials               ProductSerial[]
  order                 Order           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product               Product?        @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([order_id])
  @@map("order_items")
  @@schema("public")
}

model Order {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String?              @db.Uuid
  status                OrderStatus          @default(pending)
  payment_method        PaymentMethod?
  fulfillment_method    FulfillmentMethod    @default(delivery)
  delivery_region       DeliveryRegion?
  delivery_fee_kes      Int                  @default(0)
  delivery_name         String?
  delivery_phone        String?
  delivery_email        String?
  delivery_location     String?
  delivery_instructions String?
  total_kes             Int                  @default(0)
  customer_id           String?              @db.Uuid
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  order_items           OrderItem[]
  payments              PaymentTransaction[]
  customer              Customer?            @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  profile               Profile?             @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  serials               ProductSerial[]

  @@index([user_id])
  @@index([customer_id])
  @@index([created_at])
  @@map("orders")
  @@schema("public")
}

model Product {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  slug                       String                 @unique
  description                String
  mpn                        String?
  sku                        String?
  category_id                String?                @db.Uuid
  brand_id                   String?                @db.Uuid
  price_kes                  Int
  cost_price_kes             Int?
  supplier_name              String?
  supplier_lead_time_days    Int?
  reorder_level              Int                    @default(0)
  reorder_quantity           Int                    @default(0)
  is_published               Boolean                @default(true)
  condition                  ProductCondition       @default(new)
  stock_status               StockStatus            @default(in_stock)
  stock_quantity             Int                    @default(0)
  images                     Json                   @default("[]") @db.JsonB
  specs                      Json                   @default("{}") @db.JsonB
  is_featured                Boolean                @default(false)
  show_offer_badge           Boolean                @default(false)
  show_flash_sale_badge      Boolean                @default(false)
  archived_at                DateTime?              @db.Timestamptz(6)
  created_at                 DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  cart_items                 CartItem[]
  order_items                OrderItem[]
  quote_items                QuoteItem[]
  proforma_invoice_items     ProformaInvoiceItem[]
  invoice_items              InvoiceItem[]
  purchase_order_items       PurchaseOrderItem[]
  goods_received_items       GoodsReceivedNoteItem[]
  supplier_invoice_items     SupplierInvoiceItem[]
  tender_products            TenderProduct[]
  quote_lines                QuoteLine[]
  stock_movements            StockMovement[]
  price_history              PriceHistory[]
  serials                    ProductSerial[]
  printer_compatibilities    ProductCompatibility[] @relation("PrinterCompatibility")
  consumable_compatibilities ProductCompatibility[] @relation("ConsumableCompatibility")
  brand                      Brand?                 @relation(fields: [brand_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  category                   Category?              @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([brand_id])
  @@index([category_id])
  @@index([mpn])
  @@index([sku])
  @@index([supplier_name])
  @@index([is_published])
  @@index([archived_at])
  @@index([is_published, is_featured, created_at])
  @@index([updated_at])
  @@index([is_featured], map: "products_featured_idx")
  @@index([show_offer_badge])
  @@index([show_flash_sale_badge])
  @@map("products")
  @@schema("public")
}

model PaymentTransaction {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id            String          @db.Uuid
  provider            PaymentProvider
  method              PaymentMethod
  status              PaymentStatus   @default(pending)
  amount_kes          Int
  merchant_reference  String          @unique
  provider_reference  String?
  checkout_request_id String?         @unique
  phone               String?
  redirect_url        String?
  failure_reason      String?
  raw_request         Json?           @db.JsonB
  raw_response        Json?           @db.JsonB
  verified_at         DateTime?       @db.Timestamptz(6)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  order               Order           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id, status])
  @@index([provider, status])
  @@map("payment_transactions")
  @@schema("public")
}

model Profile {
  id                    String          @id @db.Uuid
  full_name             String?
  phone                 String?
  email                 String?
  delivery_region       DeliveryRegion?
  delivery_location     String?
  delivery_instructions String?
  role                  ProfileRole     @default(customer)
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  cart_items            CartItem[]
  orders                Order[]
  customers             Customer[]
  stock_movements       StockMovement[]
  changed_prices        PriceHistory[]  @relation("PriceChangedBy")
  audit_logs            AuditLog[]
  notifications         NotificationHistory[]
  sales_commissions     SalesCommission[]
  sales_commission_payments SalesCommissionPayment[]

  @@map("profiles")
  @@schema("public")
}

model QuoteRequest {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  email            String
  phone            String
  service_needed   String
  message          String
  status           QuoteStatus @default(new)
  owner_id         String?     @db.Uuid
  quoted_value_kes Int?
  follow_up_at     DateTime?   @db.Timestamptz(6)
  issued_at        DateTime?   @db.Timestamptz(6)
  valid_until      DateTime?   @db.Timestamptz(6)
  payment_terms    String?
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  lines            QuoteLine[]

  @@index([created_at])
  @@map("quote_requests")
  @@schema("public")
}

model DeliveryFee {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  region     DeliveryRegion @unique
  fee_kes    Int            @default(0)
  is_enabled Boolean        @default(true)
  updated_at DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("delivery_fees")
  @@schema("public")
}

model QuoteLine {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote_id       String       @db.Uuid
  product_id     String?      @db.Uuid
  description    String
  quantity       Int
  unit_price_kes Int
  unit_cost_kes  Int?
  sort_order     Int          @default(0)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  quote          QuoteRequest @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product        Product?     @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([quote_id])
  @@index([product_id])
  @@map("quote_lines")
  @@schema("public")
}

model ProductCompatibility {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  printer_id    String                   @db.Uuid
  consumable_id String                   @db.Uuid
  relation_type ProductCompatibilityType
  created_at    DateTime                 @default(now()) @db.Timestamptz(6)
  printer       Product                  @relation("PrinterCompatibility", fields: [printer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  consumable    Product                  @relation("ConsumableCompatibility", fields: [consumable_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([printer_id, consumable_id, relation_type])
  @@index([printer_id])
  @@index([consumable_id])
  @@map("product_compatibilities")
  @@schema("public")
}

model StockMovement {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String              @db.Uuid
  delta      Int
  reason     StockMovementReason
  reference  String?
  unit_cost_kes Int?
  supplier_id String?            @db.Uuid
  purchase_order_id String?      @db.Uuid
  goods_received_note_id String? @db.Uuid
  user_id    String?             @db.Uuid
  created_at DateTime            @default(now()) @db.Timestamptz(6)
  product    Product             @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  supplier   Supplier?           @relation(fields: [supplier_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  purchase_order PurchaseOrder?   @relation(fields: [purchase_order_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  goods_received_note GoodsReceivedNote? @relation(fields: [goods_received_note_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user       Profile?            @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([product_id, created_at])
  @@index([supplier_id])
  @@index([purchase_order_id])
  @@index([goods_received_note_id])
  @@index([user_id])
  @@map("stock_movements")
  @@schema("public")
}

model PriceHistory {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id     String    @db.Uuid
  price_kes      Int
  effective_from DateTime  @default(now()) @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)
  changed_by     String?   @db.Uuid
  note           String?
  product        Product   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           Profile?  @relation("PriceChangedBy", fields: [changed_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([product_id, effective_from])
  @@index([changed_by])
  @@map("price_history")
  @@schema("public")
}

model ProductSerial {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id      String              @db.Uuid
  serial_number   String
  status          ProductSerialStatus @default(IN_STOCK)
  order_id        String?             @db.Uuid
  order_item_id   String?             @db.Uuid
  delivered_at    DateTime?           @db.Timestamptz(6)
  warranty_months Int?
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  product         Product             @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order           Order?              @relation(fields: [order_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  order_item      OrderItem?          @relation(fields: [order_item_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([product_id, serial_number])
  @@index([status])
  @@index([order_id])
  @@map("product_serials")
  @@schema("public")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?  @db.Uuid
  entity     String
  entity_id  String
  action     String
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       Profile? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([entity, entity_id])
  @@index([user_id, created_at])
  @@map("audit_logs")
  @@schema("public")
}

model ServiceEntry {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String
  slug               String   @unique
  description        String
  image              String?
  price_kes          Int?
  show_request_quote Boolean  @default(true)
  sort_order         Int      @default(0)
  is_enabled         Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([is_enabled, sort_order])
  @@map("service_entries")
  @@schema("public")
}

model Customer {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id          String?           @db.Uuid
  name                String
  company_name        String?
  customer_type       CustomerType      @default(individual)
  phone               String?
  email               String?
  tax_pin             String?
  notes               String?
  created_by_id       String?           @db.Uuid
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  profile             Profile?          @relation(fields: [profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  addresses           CustomerAddress[]
  quotes              Quote[]
  proforma_invoices   ProformaInvoice[]
  invoices            Invoice[]
  payments            Payment[]
  receipts            Receipt[]
  orders              Order[]
  mpesa_transactions  MpesaTransaction[]
  expenses            Expense[]
  transactions        Transaction[]
  documents           Document[]
  company_documents   CompanyDocument[]
  credit_notes        SalesCreditNote[]
  recurring_invoices  RecurringInvoiceSchedule[]

  @@index([profile_id])
  @@index([email])
  @@index([phone])
  @@index([customer_type])
  @@map("customers")
  @@schema("public")
}

model CustomerAddress {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id        String   @db.Uuid
  label              String?
  recipient_name     String?
  phone              String?
  address_line_1     String
  address_line_2     String?
  city               String?
  region             String?
  delivery_notes     String?
  is_default         Boolean  @default(false)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  customer           Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id])
  @@map("customer_addresses")
  @@schema("public")
}

model Quote {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote_number       String          @unique
  customer_id        String          @db.Uuid
  status             BusinessQuoteStatus @default(draft)
  subtotal_kes       Int             @default(0)
  discount_kes       Int             @default(0)
  vat_kes            Int             @default(0)
  total_kes          Int             @default(0)
  vat_enabled        Boolean         @default(false)
  notes              String?
  terms              String?
  valid_until        DateTime?       @db.Date
  created_by_id      String?         @db.Uuid
  accepted_at        DateTime?       @db.Timestamptz(6)
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  customer           Customer        @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items              QuoteItem[]
  proforma_invoices  ProformaInvoice[]
  invoices           Invoice[]
  transactions       Transaction[]
  documents          Document[]

  @@index([customer_id])
  @@index([status])
  @@index([created_at])
  @@map("quotes")
  @@schema("public")
}

model QuoteItem {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote_id           String    @db.Uuid
  product_id         String?   @db.Uuid
  item_type          BusinessItemType @default(product)
  description        String
  quantity           Int
  unit_price_kes     Int
  discount_kes       Int       @default(0)
  vat_kes            Int       @default(0)
  line_total_kes     Int
  sort_order         Int       @default(0)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  quote              Quote     @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product            Product?  @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([quote_id])
  @@index([product_id])
  @@map("quote_items")
  @@schema("public")
}

model ProformaInvoice {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proforma_number    String          @unique
  quote_id           String?         @db.Uuid
  customer_id        String          @db.Uuid
  status             ProformaStatus  @default(draft)
  subtotal_kes       Int             @default(0)
  discount_kes       Int             @default(0)
  vat_kes            Int             @default(0)
  total_kes          Int             @default(0)
  vat_enabled        Boolean         @default(false)
  notes              String?
  terms              String?
  due_date           DateTime?       @db.Date
  created_by_id      String?         @db.Uuid
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  quote              Quote?          @relation(fields: [quote_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  customer           Customer        @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items              ProformaInvoiceItem[]
  payments           Payment[]
  invoices           Invoice[]
  transactions       Transaction[]
  documents          Document[]

  @@index([quote_id])
  @@index([customer_id])
  @@index([status])
  @@map("proforma_invoices")
  @@schema("public")
}

model ProformaInvoiceItem {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proforma_invoice_id   String           @db.Uuid
  product_id            String?          @db.Uuid
  item_type             BusinessItemType @default(product)
  description           String
  quantity              Int
  unit_price_kes        Int
  discount_kes          Int              @default(0)
  vat_kes               Int              @default(0)
  line_total_kes        Int
  sort_order            Int              @default(0)
  created_at            DateTime         @default(now()) @db.Timestamptz(6)
  proforma_invoice      ProformaInvoice  @relation(fields: [proforma_invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product               Product?         @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([proforma_invoice_id])
  @@index([product_id])
  @@map("proforma_invoice_items")
  @@schema("public")
}

model Invoice {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_number        String          @unique
  quote_id              String?         @db.Uuid
  proforma_invoice_id   String?         @db.Uuid
  customer_id           String          @db.Uuid
  status                InvoiceStatus   @default(draft)
  subtotal_kes          Int             @default(0)
  discount_kes          Int             @default(0)
  vat_kes               Int             @default(0)
  total_kes             Int             @default(0)
  paid_kes              Int             @default(0)
  balance_kes           Int             @default(0)
  vat_enabled           Boolean         @default(false)
  etims_status          EtimsSubmissionStatus @default(not_ready)
  etims_external_id     String?
  etims_control_number  String?
  etims_qr_reference    String?
  etims_verification_url String?
  notes                 String?
  terms                 String?
  due_date              DateTime?       @db.Date
  payment_terms         String?
  created_by_id         String?         @db.Uuid
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  quote                 Quote?          @relation(fields: [quote_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  proforma_invoice      ProformaInvoice? @relation(fields: [proforma_invoice_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  customer              Customer        @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items                 InvoiceItem[]
  payments              Payment[]
  receipts              Receipt[]
  transactions          Transaction[]
  documents             Document[]
  journal_entries       JournalEntry[]
  etims_records         EtimsRecord[]
  mpesa_transactions    MpesaTransaction[]
  credit_notes          SalesCreditNote[]
  sales_commissions     SalesCommission[]

