# Ceter Technologies environment template.
# Copy this file to .env.local for local development. Never commit real secrets.

# ==================================================
# Database
# ==================================================
# Runtime Prisma URL. Use the Supabase transaction pooler in hosted/serverless
# environments, usually port 6543.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require"

# Direct/non-pooled database URL for migrations and Prisma CLI, usually port 5432.
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Prisma connection pool size. Keep low for serverless deployments.
PRISMA_POOL_MAX=1

# Database connection timeout in milliseconds.
PRISMA_CONNECTION_TIMEOUT_MS=60000

# ==================================================
# Site
# ==================================================
# Runtime mode. Usually set automatically by Next.js/Vercel.
NODE_ENV="development"

# Vercel deployment marker. Leave blank locally; Vercel sets this automatically.
VERCEL=""

# Next.js production-build marker. Leave blank; Next.js sets this internally.
NEXT_PHASE=""

# npm lifecycle event marker. Leave blank; npm sets this while running scripts.
npm_lifecycle_event=""

# Canonical public site URL used for redirects, payment callbacks, SEO and metadata.
NEXT_PUBLIC_SITE_URL="https://www.cetertechnologies.com"

# Optional Google Search Console verification token for metadata.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Optional Vercel production hostname fallback used when NEXT_PUBLIC_SITE_URL is not set.
VERCEL_PROJECT_PRODUCTION_URL=""

# ==================================================
# Supabase
# ==================================================
# Public Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"

# Public anon key used by browser and server Supabase clients.
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUPABASE_ANON_KEY_PLACEHOLDER"

# Backward-compatible anon key aliases used by middleware/server config.
SUPABASE_ANON_KEY="SUPABASE_ANON_KEY_PLACEHOLDER"
SUPABASE_PUBLISHABLE_KEY="SUPABASE_PUBLISHABLE_KEY_PLACEHOLDER"

# Service role key used only by trusted server-side admin actions and scripts.
SUPABASE_SERVICE_ROLE_KEY="SUPABASE_SERVICE_ROLE_KEY_PLACEHOLDER"

# Storage bucket for product catalogue images.
SUPABASE_PRODUCT_IMAGES_BUCKET="product-images"

# Storage bucket for homepage/category/service banner images.
SUPABASE_BANNER_IMAGES_BUCKET="banner-images"

# Storage bucket for generated PDFs, expense attachments and the document vault.
# Keep this Supabase bucket private. The app creates short-lived signed URLs
# after account/admin authorization checks.
SUPABASE_BUSINESS_DOCUMENTS_BUCKET="business-documents"
BUSINESS_DOCUMENT_SIGNED_URL_SECONDS=300

# ==================================================
# Business Suite Company Profile
# ==================================================
# Company details printed on generated quotations, pro-formas, invoices,
# receipts, purchase orders and statements.
CETER_COMPANY_NAME="Ceter Technologies Limited"
CETER_COMPANY_ADDRESS="Nairobi, Kenya"
CETER_COMPANY_PHONE="+254 700 000 000"
CETER_COMPANY_EMAIL="info@cetertechnologies.com"
CETER_COMPANY_WEBSITE="www.cetertechnologies.com"
CETER_COMPANY_TAX_PIN="P000000000X"

# Payment instructions printed in generated business documents.
CETER_DOCUMENT_PAYMENT_INSTRUCTIONS="Confirm bank or M-Pesa instructions with Ceter Technologies Limited before payment."

# ==================================================
# Tax and Pricing
# ==================================================
# VAT rate used by checkout/payment calculations.
VAT_RATE=0.16

# Public VAT rate for client-side display where needed.
NEXT_PUBLIC_VAT_RATE=0.16

# ==================================================
# PDF / Document Generation
# ==================================================
# Current generator emits A4 portrait PDFs. Keep this as A4 unless templates are
# updated to support another size.
BUSINESS_PDF_PAGE_SIZE="A4"

# Optional branding color documentation for future PDF renderer changes.
BUSINESS_DOCUMENT_BRAND_COLOR="#082635"

# ==================================================
# Payments - Safaricom Daraja M-Pesa STK Push
# ==================================================
MPESA_ENVIRONMENT="sandbox"
# Backward-compatible alias; MPESA_ENVIRONMENT is preferred.
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="MPESA_CONSUMER_KEY_PLACEHOLDER"
MPESA_CONSUMER_SECRET="MPESA_CONSUMER_SECRET_PLACEHOLDER"
MPESA_SHORTCODE="MPESA_SHORTCODE_PLACEHOLDER"
MPESA_PASSKEY="MPESA_PASSKEY_PLACEHOLDER"
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
MPESA_PENDING_TIMEOUT_MINUTES=15

# ==================================================
# Payments - Pesapal API 3.0 Card Payments
# ==================================================
PESAPAL_ENV="sandbox"
PESAPAL_CONSUMER_KEY="PESAPAL_CONSUMER_KEY_PLACEHOLDER"
PESAPAL_CONSUMER_SECRET="PESAPAL_CONSUMER_SECRET_PLACEHOLDER"
PESAPAL_IPN_ID="PESAPAL_IPN_ID_PLACEHOLDER"

# ==================================================
# Tax Integrations - eTIMS Preparation
# ==================================================
# Placeholders only. The current ERP module prepares records for future eTIMS
# submission and does not submit to KRA.
ETIMS_ENV="sandbox"
ETIMS_API_URL="https://etims-api.example.invalid"
ETIMS_API_KEY="ETIMS_API_KEY_PLACEHOLDER"
ETIMS_CLIENT_ID="ETIMS_CLIENT_ID_PLACEHOLDER"
ETIMS_CLIENT_SECRET="ETIMS_CLIENT_SECRET_PLACEHOLDER"
ETIMS_DEVICE_ID="ETIMS_DEVICE_ID_PLACEHOLDER"
ETIMS_TAXPAYER_PIN="P000000000X"
ETIMS_REQUEST_TIMEOUT_MS=20000

# ==================================================
# Email / SMTP
# ==================================================
# Outbound transactional email for invoices, quotes, payment receipts and
# account document notifications. Use either the SMTP_* names or compatible
# EMAIL_* aliases below.
SMTP_HOST="smtp.example.invalid"
SMTP_PORT=587
SMTP_USER="SMTP_USER_PLACEHOLDER"
SMTP_PASSWORD="SMTP_PASSWORD_PLACEHOLDER"
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_MS=15000
SMTP_MAX_RETRIES=3
SMTP_FROM_NAME="Ceter Technologies"
SMTP_FROM_EMAIL="no-reply@cetertechnologies.com"

# Generic future email provider labels used by notification service expansion.
EMAIL_PROVIDER="smtp"
EMAIL_HOST="smtp.example.invalid"
EMAIL_USERNAME="SMTP_USER_PLACEHOLDER"
EMAIL_PASSWORD="SMTP_PASSWORD_PLACEHOLDER"

# Generic future storage provider labels for deploy documentation.
STORAGE_PROVIDER="supabase"
STORAGE_KEY="SUPABASE_SERVICE_ROLE_KEY_PLACEHOLDER"

# ==================================================
# Admin Bootstrap Script
# ==================================================
# Only needed when running npm run setup:admin.
ADMIN_EMAIL="admin@example.invalid"
ADMIN_NAME="Admin User"
ADMIN_PASSWORD="CHANGE_ME_FOR_LOCAL_ONLY"
