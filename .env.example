# Application/runtime Prisma URL. On Vercel/serverless, use the Supabase
# Supavisor transaction pooler URL, usually port 6543.
DATABASE_URL=
PRISMA_POOL_MAX=1
PRISMA_CONNECTION_TIMEOUT_MS=60000

# Migration/admin URL. Use the direct Supabase database URL on port 5432.
# Do not use the transaction pooler for Prisma migrations.
POSTGRES_URL_NON_POOLING=
NEXT_PUBLIC_SITE_URL=https://www.cetertechnologies.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
VERCEL_PROJECT_PRODUCTION_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
SUPABASE_BANNER_IMAGES_BUCKET=banner-images
VAT_RATE=0.16
NEXT_PUBLIC_VAT_RATE=0.16

# Safaricom Daraja M-Pesa STK Push
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Pesapal API 3.0 card payments
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=

# Only needed when running `npm.cmd run setup:admin`.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
